@using DotNet_Header_Footer.Models

@{
    var settings = ViewBag.SiteSettings as SiteSettings;

    var brandName = string.IsNullOrWhiteSpace(settings?.BrandName)
        ? "FASHIONHUB"
        : settings.BrandName.Trim();

    // =========================================================
    // LOGO PATH
    // =========================================================

    var logoValue = settings?.Logo;
    string logoPath = Url.Content("~/Images/logo.png");

    if (!string.IsNullOrWhiteSpace(logoValue))
    {
        logoValue = logoValue.Trim();

        if (logoValue.StartsWith("~/"))
        {
            logoPath = Url.Content(logoValue);
        }
        else if (logoValue.StartsWith("/"))
        {
            logoPath = logoValue;
        }
        else if (logoValue.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                 logoValue.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            logoPath = logoValue;
        }
        else
        {
            logoPath = Url.Content("~/Images/" + logoValue.TrimStart('/'));
        }
    }

    var address = string.IsNullOrWhiteSpace(settings?.Address)
        ? "Ahmedabad, Gujarat, India"
        : settings.Address.Trim();

    var phone = string.IsNullOrWhiteSpace(settings?.Phone)
        ? "+91 98765 43210"
        : settings.Phone.Trim();

    var email = string.IsNullOrWhiteSpace(settings?.Email)
        ? "support@fashionhub.com"
        : settings.Email.Trim();

    var facebook = string.IsNullOrWhiteSpace(settings?.FacebookUrl)
        ? "#"
        : settings.FacebookUrl.Trim();

    var instagram = string.IsNullOrWhiteSpace(settings?.InstagramUrl)
        ? "#"
        : settings.InstagramUrl.Trim();

    var twitter = string.IsNullOrWhiteSpace(settings?.TwitterUrl)
        ? "#"
        : settings.TwitterUrl.Trim();

    var map = string.IsNullOrWhiteSpace(settings?.MapEmbedUrl)
        ? "https://www.google.com/maps?q=Ahmedabad,Gujarat,India&output=embed"
        : settings.MapEmbedUrl.Trim();

    var copyright = string.IsNullOrWhiteSpace(settings?.CopyrightText)
        ? $"© {DateTime.Now.Year} {brandName}. All Rights Reserved."
        : settings.CopyrightText.Trim();

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color"
          content="#111111" />

    <title>
        @ViewData["Title"] - @brandName
    </title>

    <!-- =====================================================
         BOOTSTRAP
    ====================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- =====================================================
         BOOTSTRAP ICONS
    ====================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- =====================================================
         GOOGLE FONT
    ====================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
          rel="stylesheet" />

    <!-- =====================================================
         CUSTOM CSS
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <!-- =====================================================
         TOP OFFER BAR
    ====================================================== -->

    <div class="top-bar">

        <div class="site-container">

            <div class="top-bar-inner">

                <div class="top-left">
                    <i class="bi bi-truck"></i>
                    <span>Free Shipping on orders above ₹999</span>
                </div>

                <div class="top-center">
                    New Season Collection — Up to 50% OFF
                </div>

                <div class="top-right">

                    <a href="tel:@phone">
                        <i class="bi bi-telephone"></i>
                        <span>@phone</span>
                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="site-header">

        <div class="site-container">

            <div class="header-main">

                <!-- LOGO -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="brand"
                   aria-label="@brandName Home">

                    <img src="@logoPath"
                         alt="@brandName"
                         class="brand-image"
                         loading="eager"
                         onerror="this.onerror=null;this.src='@Url.Content("~/Images/logo.png")';" />

                </a>


                <!-- DESKTOP SEARCH -->

                <div class="desktop-search">

                    <form asp-controller="Home"
                          asp-action="Index"
                          method="get">

                        <div class="search-wrapper">

                            <i class="bi bi-search search-icon"></i>

                            <input type="text"
                                   name="search"
                                   value="@Context.Request.Query["search"]"
                                   placeholder="Search products, brands & categories..."
                                   autocomplete="off" />

                            <button type="submit">
                                Search
                            </button>

                        </div>

                    </form>

                </div>


                <!-- HEADER ACTIONS -->

                <div class="header-actions">

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="header-action"
                       aria-label="Account">

                        <div class="action-icon">
                            <i class="bi bi-person"></i>
                        </div>

                        <span>Account</span>

                    </a>


                    <a asp-controller="Wishlist"
                       asp-action="Index"
                       class="header-action wishlist-action"
                       aria-label="Wishlist">

                        <div class="action-icon">
                            <i class="bi bi-heart"></i>
                        </div>

                        <span>Wishlist</span>

                    </a>


                    <a asp-controller="Cart"
                       asp-action="Index"
                       class="header-action cart-action"
                       aria-label="Cart">

                        <div class="action-icon">

                            <i class="bi bi-bag"></i>

                            <span class="cart-badge">
                                0
                            </span>

                        </div>

                        <span>Cart</span>

                    </a>

                </div>


                <!-- MOBILE MENU -->

                <button class="mobile-menu-button"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#mobileMenu"
                        aria-controls="mobileMenu"
                        aria-label="Open menu">

                    <i class="bi bi-list"></i>

                </button>

            </div>


            <!-- MOBILE SEARCH -->

            <div class="mobile-search">

                <form asp-controller="Home"
                      asp-action="Index"
                      method="get">

                    <div class="mobile-search-box">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               name="search"
                               value="@Context.Request.Query["search"]"
                               placeholder="Search products..."
                               autocomplete="off" />

                        <button type="submit"
                                aria-label="Search">

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </div>

                </form>

            </div>

        </div>


        <!-- =====================================================
             NAVIGATION
        ====================================================== -->

        <nav class="main-navigation">

            <div class="site-container">

                <div class="navigation-inner">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="@(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                        Home
                    </a>

                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-slug="men">
                        Men
                    </a>

                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-slug="women">
                        Women
                    </a>

                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-slug="kids">
                        Kids
                    </a>
                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-slug="clothing">
                        Clothing
                    </a>

                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-slug="shoes">
                        Shoes
                    </a>

                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-slug="accessories">
                        Accessories
                    </a>

                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-slug="new-arrivals">
                        New Arrivals
                    </a>

                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-slug="sale"
                       class="sale-item">

                        <i class="bi bi-fire"></i>
                        Sale

                    </a>

                </div>

            </div>

        </nav>

    </header>


    <!-- =====================================================
         MOBILE OFFCANVAS
    ====================================================== -->

    <div class="offcanvas offcanvas-end mobile-offcanvas"
         tabindex="-1"
         id="mobileMenu"
         aria-labelledby="mobileMenuLabel">

        <div class="offcanvas-header">

            <a asp-controller="Home"
               asp-action="Index"
               class="mobile-brand"
               id="mobileMenuLabel">

                <img src="@logoPath"
                     alt="@brandName"
                     class="mobile-brand-image"
                     onerror="this.onerror=null;this.src='@Url.Content("~/Images/logo.png")';" />

            </a>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close">
            </button>

        </div>


        <div class="offcanvas-body">

            <div class="mobile-nav">

                <a asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-house"></i>
                    <span>Home</span>

                </a>

                <a asp-controller="Home"
                   asp-action="Category"
                   asp-route-slug="men">

                    <i class="bi bi-person-standing"></i>
                    <span>Men</span>

                </a>

                <a asp-controller="Home"
                   asp-action="Category"
                   asp-route-slug="women">

                    <i class="bi bi-person"></i>
                    <span>Women</span>

                </a>

                <a asp-controller="Home"
                   asp-action="Category"
                   asp-route-slug="kids">

                    <i class="bi bi-stars"></i>
                    <span>Kids</span>

                </a>

                <a asp-controller="Home"
                   asp-action="Category"
                   asp-route-slug="clothing">

                    <i class="bi bi-grid"></i>
                    <span>Clothing</span>

                </a>

                <a asp-controller="Home"
                   asp-action="Category"
                   asp-route-slug="shoes">

                    <i class="bi bi-shoe-print"></i>
                    <span>Shoes</span>

                </a>

                <a asp-controller="Home"
                   asp-action="Category"
                   asp-route-slug="accessories">

                    <i class="bi bi-watch"></i>
                    <span>Accessories</span>

                </a>

                <a asp-controller="Home"
                   asp-action="Category"
                   asp-route-slug="new-arrivals">

                    <i class="bi bi-bag-plus"></i>
                    <span>New Arrivals</span>

                </a>

                <a asp-controller="Home"
                   asp-action="Category"
                   asp-route-slug="sale"
                   class="mobile-sale">

                    <i class="bi bi-fire"></i>
                    <span>Sale</span>

                </a>

            </div>


            <div class="mobile-contact">

                <a href="tel:@phone">
                    <i class="bi bi-telephone"></i>
                    <span>@phone</span>
                </a>

                <a href="mailto:@email">
                    <i class="bi bi-envelope"></i>
                    <span>@email</span>
                </a>

            </div>

        </div>

    </div>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main>
        @RenderBody()
    </main>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="site-footer">


        <!-- =====================================================
             NEWSLETTER
        ====================================================== -->

        <section class="newsletter">

            <div class="site-container">

                <div class="newsletter-inner">

                    <div class="newsletter-text">

                        <span>STAY IN STYLE</span>

                        <h2>
                            Get 10% off your first order
                        </h2>

                        <p>
                            Subscribe to receive exclusive offers,
                            new arrivals and fashion updates.
                        </p>

                    </div>


                    <form asp-controller="Home"
                          asp-action="SubscribeNewsletter"
                          method="post"
                          class="newsletter-form">

                        @Html.AntiForgeryToken()

                        <input type="email"
                               name="email"
                               placeholder="Enter your email address"
                               autocomplete="email"
                               required />

                        <button type="submit">

                            <span>Subscribe</span>

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </form>

                </div>


                @if (TempData["NewsletterSuccess"] != null)
                {
                    <div class="alert alert-success newsletter-alert">
                        @TempData["NewsletterSuccess"]
                    </div>
                }

                @if (TempData["NewsletterError"] != null)
                {
                    <div class="alert alert-danger newsletter-alert">
                        @TempData["NewsletterError"]
                    </div>
                }

            </div>

        </section>


        <!-- =====================================================
             FOOTER CONTENT
        ====================================================== -->

        <div class="site-container">

            <div class="footer-grid">


                <!-- BRAND -->

                <div class="footer-about">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="footer-brand"
                       aria-label="@brandName Home">

                        <img src="@logoPath"
                             alt="@brandName"
                             class="footer-logo"
                             loading="lazy"
                             onerror="this.onerror=null;this.src='@Url.Content("~/Images/logo.png")';" />

                    </a>


                    <p class="footer-description">
                        Discover premium fashion, modern styles
                        and timeless clothing designed to make
                        every day look better.
                    </p>


                    <div class="social-links">

                        <a href="@facebook"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Facebook">

                            <i class="bi bi-facebook"></i>

                        </a>

                        <a href="@instagram"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Instagram">

                            <i class="bi bi-instagram"></i>

                        </a>

                        <a href="@twitter"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Twitter">

                            <i class="bi bi-twitter-x"></i>

                        </a>

                    </div>

                </div>


                <!-- SHOP -->

                <div class="footer-column">

                    <h4>Shop</h4>

                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-slug="men">
                        Men
                    </a>

                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-slug="women">
                        Women
                    </a>

                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-slug="kids">
                        Kids
                    </a>

                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-slug="new-arrivals">
                        New Arrivals
                    </a>

                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-slug="sale">
                        Sale
                    </a>

                </div>


                <!-- HELP -->

                <div class="footer-column">

                    <h4>Help</h4>

                    <a asp-controller="Contact"
                       asp-action="Index">
                        Contact Us
                    </a>

                    <a href="#">
                        Shipping &amp; Delivery
                    </a>

                    <a href="#">
                        Returns &amp; Refunds
                    </a>

                    <a href="#">
                        Privacy Policy
                    </a>

                    <a href="#">
                        Terms &amp; Conditions
                    </a>

                </div>


                <!-- CONTACT -->

                <div class="footer-column contact-column">

                    <h4>Contact</h4>

                    <div class="contact-item">

                        <i class="bi bi-geo-alt-fill"></i>

                        <span>
                            @address
                        </span>

                    </div>


                    <div class="contact-item">

                        <i class="bi bi-telephone-fill"></i>

                        <a href="tel:@phone">
                            @phone
                        </a>

                    </div>


                    <div class="contact-item">

                        <i class="bi bi-envelope-fill"></i>

                        <a href="mailto:@email">
                            @email
                        </a>

                    </div>

                </div>


                <!-- MAP -->

                <div class="footer-map-column">

                    <h4>Our Location</h4>

                    <div class="footer-map-wrapper">

                        <iframe src="@map"
                                title="Our Location"
                                loading="lazy"
                                allowfullscreen
                                referrerpolicy="no-referrer-when-downgrade">
                        </iframe>

                    </div>


                    <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(address)"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="footer-map-button">

                        <i class="bi bi-geo-alt-fill"></i>

                        <span>Get Directions</span>

                        <i class="bi bi-arrow-up-right"></i>

                    </a>

                </div>

            </div>

        </div>


        <!-- =====================================================
             FOOTER BOTTOM
        ====================================================== -->

        <div class="footer-bottom">

            <div class="site-container">

                <div class="footer-bottom-inner">

                    <p>
                        @copyright
                    </p>


                    <div class="payment-methods">

                        <span title="Credit Card">
                            <i class="bi bi-credit-card"></i>
                        </span>

                        <span title="Wallet">
                            <i class="bi bi-wallet2"></i>
                        </span>

                        <span title="Cash">
                            <i class="bi bi-cash-stack"></i>
                        </span>

                        <span title="Bank">
                            <i class="bi bi-bank"></i>
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </footer>


    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>