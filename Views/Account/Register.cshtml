@model DotNet_Header_Footer.Models.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="auth-page">

    <div class="auth-container">

        <div class="auth-card">


            <!-- =====================================================
                 LEFT SIDE
            ====================================================== -->

            <div class="auth-info">

                <div class="auth-brand">

                    <a asp-controller="Home"
                       asp-action="Index">

                        FASHIONHUB

                    </a>

                </div>


                <div class="auth-info-content">

                    <span class="auth-small-title">
                        JOIN OUR COMMUNITY
                    </span>

                    <h1>
                        Your style starts here.
                    </h1>

                    <p>
                        Create your account and discover
                        premium fashion, new arrivals,
                        exclusive offers and much more.
                    </p>


                    <div class="auth-benefits">

                        <div class="auth-benefit">

                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                Exclusive fashion collections
                            </span>

                        </div>


                        <div class="auth-benefit">

                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                Special member offers
                            </span>

                        </div>


                        <div class="auth-benefit">

                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                Easy order tracking
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 REGISTER FORM
            ====================================================== -->

            <div class="auth-form-wrapper">

                <div class="auth-form-header">

                    <span>
                        GET STARTED
                    </span>

                    <h2>
                        Create Account
                    </h2>

                    <p>
                        Enter your details to create your account.
                    </p>

                </div>


                <form asp-action="Register"
                      method="post"
                      novalidate>

                    @Html.AntiForgeryToken()


                    <!-- MODEL LEVEL ERRORS -->

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger auth-validation">
                    </div>


                    <!-- =================================================
                         FULL NAME
                    ================================================== -->

                    <div class="form-group">

                        <label asp-for="FullName">
                            Full Name
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-person"></i>

                            <input asp-for="FullName"
                                   class="form-control"
                                   placeholder="Enter your full name"
                                   autocomplete="name" />

                        </div>

                        <span asp-validation-for="FullName"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- =================================================
                         EMAIL
                    ================================================== -->

                    <div class="form-group">

                        <label asp-for="Email">
                            Email Address
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-envelope"></i>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Enter your email"
                                   autocomplete="email" />

                        </div>

                        <span asp-validation-for="Email"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- =================================================
                         PHONE
                    ================================================== -->

                    <div class="form-group">

                        <label asp-for="Phone">
                            Phone Number
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-telephone"></i>

                            <input asp-for="Phone"
                                   class="form-control"
                                   placeholder="10-digit mobile number"
                                   maxlength="10"
                                   autocomplete="tel" />

                        </div>

                        <span asp-validation-for="Phone"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- =================================================
                         PASSWORD
                    ================================================== -->

                    <div class="form-group">

                        <label asp-for="Password">
                            Password
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-lock"></i>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Minimum 8 characters"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('Password', this)">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Password"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- =================================================
                         CONFIRM PASSWORD
                    ================================================== -->

                    <div class="form-group">

                        <label asp-for="ConfirmPassword">
                            Confirm Password
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-shield-lock"></i>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Confirm your password"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('ConfirmPassword', this)">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- =================================================
                         REGISTER BUTTON
                    ================================================== -->

                    <button type="submit"
                            class="auth-submit">

                        <span>
                            Create Account
                        </span>

                        <i class="bi bi-arrow-right"></i>

                    </button>


                    <!-- =================================================
                         LOGIN LINK
                    ================================================== -->

                    <div class="auth-switch">

                        <span>
                            Already have an account?
                        </span>

                        <a asp-controller="Account"
                           asp-action="Login">

                            Login

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        function togglePassword(inputId, button) {

            const input =
                document.getElementById(inputId);

            const icon =
                button.querySelector("i");

            if (input.type === "password") {

                input.type = "text";

                icon.classList.remove("bi-eye");

                icon.classList.add("bi-eye-slash");

            }
            else {

                input.type = "password";

                icon.classList.remove("bi-eye-slash");

                icon.classList.add("bi-eye");

            }
        }

    </script>
}