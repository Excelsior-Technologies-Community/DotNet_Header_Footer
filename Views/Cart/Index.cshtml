@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container py-5">

    <h1 class="fw-bold mb-4">
        Shopping Cart
    </h1>

    <div class="text-center py-5">

        <i class="bi bi-bag-x"
           style="font-size:70px;"></i>

        <h3 class="mt-3">
            Your cart is empty
        </h3>

        <p class="text-muted">
            Add some products to your cart.
        </p>

        <a asp-controller="Home"
           asp-action="Category"
           asp-route-slug="new-arrivals"
           class="btn btn-dark">

            Start Shopping

        </a>

    </div>

</div>