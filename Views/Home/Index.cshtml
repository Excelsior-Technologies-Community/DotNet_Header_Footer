@{
    ViewData["Title"] = "Home";
}

<!-- =========================================================
     HERO
========================================================== -->

<section class="hero">

    <div class="container">

        <div class="hero-grid">


            <!-- LEFT -->

            <div class="hero-content">

                <span class="hero-label">
                    NEW COLLECTION 2026
                </span>

                <h1>
                    Style that
                    <br />
                    <em>speaks</em> for you.
                </h1>

                <p>
                    Discover carefully selected fashion pieces
                    created for modern lifestyles. Premium quality,
                    effortless style and comfort in every detail.
                </p>


                <div class="hero-buttons">

                    <a href="#categories"
                       class="btn-primary-custom">

                        Shop Collection

                        <i class="bi bi-arrow-right"></i>

                    </a>

                    <a href="#categories"
                       class="btn-secondary-custom">

                        Explore More

                    </a>

                </div>


                <!-- FEATURES -->

                <div class="hero-features">

                    <div>

                        <i class="bi bi-truck"></i>

                        <span>
                            Free Shipping
                        </span>

                    </div>

                    <div>

                        <i class="bi bi-arrow-repeat"></i>

                        <span>
                            Easy Returns
                        </span>

                    </div>

                    <div>

                        <i class="bi bi-shield-check"></i>

                        <span>
                            Secure Payment
                        </span>

                    </div>

                </div>

            </div>


            <!-- RIGHT IMAGE AREA -->

            <div class="hero-visual">

                <div class="hero-image-placeholder">

                    <div class="fashion-icon">

                        <i class="bi bi-bag-heart"></i>

                    </div>

                    <span>
                        STYLEHUB
                    </span>

                    <small>
                        FASHION • STYLE • YOU
                    </small>

                </div>


                <div class="hero-floating-card">

                    <strong>
                        50%
                    </strong>

                    <span>
                        OFF
                    </span>

                    <small>
                        NEW SEASON
                    </small>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     CATEGORY
========================================================== -->

<section class="categories-section"
         id="categories">

    <div class="container">


        <div class="section-heading">

            <div>

                <span>
                    SHOP BY CATEGORY
                </span>

                <h2>
                    Find Your Style
                </h2>

            </div>

            <a href="#">
                View All
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>


        <div class="category-grid">


            <!-- MEN -->

            <a href="#"
               class="category-card">

                <div class="category-icon">

                    <i class="bi bi-person-standing"></i>

                </div>

                <div>

                    <h3>
                        Men's Fashion
                    </h3>

                    <p>
                        Modern essentials
                    </p>

                </div>

                <i class="bi bi-arrow-up-right category-arrow"></i>

            </a>


            <!-- WOMEN -->

            <a href="#"
               class="category-card">

                <div class="category-icon">

                    <i class="bi bi-person"></i>

                </div>

                <div>

                    <h3>
                        Women's Fashion
                    </h3>

                    <p>
                        Elegant collections
                    </p>

                </div>

                <i class="bi bi-arrow-up-right category-arrow"></i>

            </a>


            <!-- KIDS -->

            <a href="#"
               class="category-card">

                <div class="category-icon">

                    <i class="bi bi-stars"></i>

                </div>

                <div>

                    <h3>
                        Kids Collection
                    </h3>

                    <p>
                        Cute & comfortable
                    </p>

                </div>

                <i class="bi bi-arrow-up-right category-arrow"></i>

            </a>


            <!-- SHOES -->

            <a href="#"
               class="category-card">

                <div class="category-icon">

                    <i class="bi bi-shoe-print"></i>

                </div>

                <div>

                    <h3>
                        Shoes
                    </h3>

                    <p>
                        Step in style
                    </p>

                </div>

                <i class="bi bi-arrow-up-right category-arrow"></i>

            </a>

        </div>

    </div>

</section>


<!-- =========================================================
     WHY US
========================================================== -->

<section class="why-section">

    <div class="container">

        <div class="why-grid">

            <div>

                <span class="section-mini-title">
                    WHY STYLEHUB
                </span>

                <h2>
                    Fashion made
                    <br />
                    <em>simple.</em>
                </h2>

                <p>
                    From everyday essentials to statement pieces,
                    we bring together fashion that fits your style,
                    personality and lifestyle.
                </p>

                <a href="#"
                   class="text-link">

                    Discover More
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>


            <div class="why-features">

                <div class="why-card">

                    <div class="why-icon">
                        <i class="bi bi-gem"></i>
                    </div>

                    <h4>
                        Premium Quality
                    </h4>

                    <p>
                        Carefully selected materials
                        and quality craftsmanship.
                    </p>

                </div>


                <div class="why-card">

                    <div class="why-icon">
                        <i class="bi bi-truck"></i>
                    </div>

                    <h4>
                        Fast Delivery
                    </h4>

                    <p>
                        Quick and reliable delivery
                        right to your doorstep.
                    </p>

                </div>


                <div class="why-card">

                    <div class="why-icon">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>

                    <h4>
                        Easy Returns
                    </h4>

                    <p>
                        Simple and hassle-free
                        return experience.
                    </p>

                </div>


                <div class="why-card">

                    <div class="why-icon">
                        <i class="bi bi-headset"></i>
                    </div>

                    <h4>
                        24/7 Support
                    </h4>

                    <p>
                        Our team is always here
                        to help you.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>